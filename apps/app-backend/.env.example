# Server Configuration
HOST=0.0.0.0
PORT=8080

# ClickHouse Database Configuration
# Local default port for ClickHouse HTTP interface is 8123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=False

# Authentication (CHANGE AUTH_SECRET_KEY before deployment)
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ISSUER=asi-telemetry
TOKEN_AUDIENCE=asi-telemetry-api
AUTH_DATABASE_PATH=./data/auth.db

# Google OAuth 2.0 Credentials (Get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://asi-telemetry-backend.vercel.app/api/auth/oauth/callback
ALLOWED_REDIRECT_URIS=https://asi-telemetry-backend.vercel.app/api/auth/oauth/callback,http://localhost:8080/api/auth/oauth/callback
FRONTEND_BASE_URL=https://asi-telemetry.vercel.app


