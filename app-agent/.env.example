# Local environment file - NEVER commit real values.
# Copy to app-agent/.env and fill in.

# --- Agent identity / runtime ---
AGENT_NAME=asi_telemetry_agent
# Seed phrase derives the agent's Fetch.ai address. Required to RUN the agent.
# Generate one (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# and keep it secret. It is never committed and never logged.
AGENT_SEED_PHRASE=
# Local HTTP port for the uAgent (used with AGENT_ENDPOINT below).
AGENT_PORT=8200
# Publicly reachable endpoint URL(s), comma-separated. For local development
# the default derived from AGENT_PORT is fine. For Agentverse/ASI:ONE
# registration you must expose this via HTTPS (reverse proxy or tunnel),
# e.g. https://your-domain.example/submit
AGENT_ENDPOINT=
# Set to true to use the Agentverse mailbox service instead of a public
# endpoint (agent connects outbound; no inbound port needed).
AGENT_MAILBOX=false

# --- ASI-Telemetry backend integration ---
# Base URL of the existing FastAPI backend (apps/app-backend).
TELEMETRY_API_BASE_URL=http://localhost:8080
# How chat users authenticate. Currently only "link": each chat participant
# links their own dashboard API key via the chat command `link account <key>`.
TELEMETRY_ACCOUNT_AUTH_MODE=link

# --- Agentverse registration (only needed for the registration script) ---
# Create at https://agentverse.ai -> Settings -> API Keys. Not used at runtime.
AGENTVERSE_API_KEY=

# --- Runtime tuning ---
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
